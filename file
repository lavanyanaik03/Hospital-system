              <h1 className="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.12]">
                JANASEVA —{" "}
                <span className="text-[#2DD4BF]">{t.tagline}</span>
              </h1>

              {/* Mandatory Prominent Message per Section 2 */}
