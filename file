"use client";

import React, { useState, useEffect, useCallback } from "react";
import {
  ShieldPlus,
  Mic,
  PhoneCall,
  Search,
  ShieldCheck,
  Bell,
  AlertTriangle,
  Globe,
  CheckCircle2,
  UserCheck,
  Building2,
  Sparkles,
  Volume2,
  ArrowRight,
  HelpCircle,
  Users,
  Radio,
  FileText,
  X,
} from "lucide-react";
import { TRANSLATIONS, UILanguage } from "@/lib/i18n";
import ComplaintRegistrationSection from "@/components/ComplaintRegistrationSection";
import IvrSimulatorSection from "@/components/IvrSimulatorSection";
import ComplaintTrackingSection from "@/components/ComplaintTrackingSection";
import AdminDashboardSection from "@/components/AdminDashboardSection";

interface NotificationItem {
  id: number;
  complaintId: string;
  recipientType: string;
  recipientContact: string;
  channel: string;
  title: string;
  message: string;
  type: string;
  isRead: boolean;
  createdAt: string;
}

export default function JanasevaHomePage() {
  const [uiLang, setUiLang] = useState<UILanguage>("en");
  const [activeNav, setActiveNav] = useState<
    "ALL" | "REPORT" | "IVR" | "TRACK" | "ADMIN"
  >("ALL");
  const [trackingComplaintId, setTrackingComplaintId] =
    useState<string>("JSV-2026-1001");
  const [recentSessionIds, setRecentSessionIds] = useState<string[]>([]);
  const [isAdminAuthenticated, setIsAdminAuthenticated] =
    useState<boolean>(false);

  // Citizen Quick Access Modal state
  const [showCitizenModal, setShowCitizenModal] = useState<boolean>(false);
  const [citizenPhoneInput, setCitizenPhoneInput] =
    useState<string>("98450-11223");
  const [citizenLoggedInPhone, setCitizenLoggedInPhone] = useState<string>("");

  // Notifications Drawer state
  const [showNotifications, setShowNotifications] = useState<boolean>(false);
  const [notificationsList, setNotificationsList] = useState<
    NotificationItem[]
  >([]);

  const t = TRANSLATIONS[uiLang];

  const loadNotifications = useCallback(async () => {
    try {
      const res = await fetch("/api/notifications");
      if (res.ok) {
        const data = await res.json();
        setNotificationsList(data.notifications || []);
      }
    } catch {
      // ignore
    }
  }, []);

  useEffect(() => {
    loadNotifications();
  }, [loadNotifications]);

  const unreadCount = notificationsList.filter((n) => !n.isRead).length;

  const handleMarkAllNotificationsRead = async () => {
    try {
      await fetch("/api/notifications", {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ markAllRead: true }),
      });
      setNotificationsList((prev) =>
        prev.map((n) => ({ ...n, isRead: true }))
      );
    } catch {
      // ignore
    }
  };

  const navigateToSection = (
    section: "ALL" | "REPORT" | "IVR" | "TRACK" | "ADMIN",
    elementId?: string
  ) => {
    setActiveNav(section);
    setTimeout(() => {
      if (elementId && typeof document !== "undefined") {
        const el = document.getElementById(elementId);
        if (el) {
          el.scrollIntoView({ behavior: "smooth", block: "start" });
        }
      } else if (typeof window !== "undefined") {
        window.scrollTo({ top: 0, behavior: "smooth" });
      }
    }, 60);
  };

  const handleComplaintSubmitted = (newId: string) => {
    setRecentSessionIds((prev) =>
      prev.includes(newId) ? prev : [newId, ...prev]
    );
    setTrackingComplaintId(newId);
    loadNotifications();
  };

  const handleTrackSpecificComplaint = (complaintId: string) => {
    setTrackingComplaintId(complaintId);
    navigateToSection("ALL", "track-section");
  };

  return (
    <div className="min-h-screen flex flex-col bg-[#F8FAFC] text-[#0F172A]">
      {/* 1. MANDATORY NON-EMERGENCY WARNING BANNER */}
      <div className="bg-amber-50 border-b-2 border-[#D97706] px-4 py-2.5 text-amber-950">
        <div className="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-2 text-xs sm:text-sm">
          <div className="flex items-center gap-2.5 font-semibold text-center sm:text-left">
            <AlertTriangle className="w-5 h-5 text-[#D97706] shrink-0" />
            <span>
              <strong className="uppercase tracking-wide mr-1.5">
                {t.emergencyWarningTitle}:
              </strong>
              {t.emergencyWarningText}
            </span>
          </div>
          <span className="px-2.5 py-0.5 rounded-full bg-red-600 text-white font-mono text-xs font-extrabold shrink-0">
            EMERGENCY: DIAL 108 / 112
          </span>
        </div>
      </div>

      {/* 2. STICKY ACCESSIBLE CIVIC HEADER */}
      <header className="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-xs">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-3">
          {/* Brand Logo & Name */}
          <button
            type="button"
            onClick={() => navigateToSection("ALL")}
            className="flex items-center gap-3 text-left cursor-pointer"
          >
            <div className="w-12 h-12 rounded-2xl bg-[#0B2545] text-white flex items-center justify-center shadow-sm border-2 border-[#0D9488]">
              <ShieldPlus className="w-7 h-7 text-[#14B8A6]" />
            </div>
            <div>
              <div className="flex items-center gap-2">
                <span className="text-xl sm:text-2xl font-extrabold tracking-tight text-[#0B2545]">
                  {t.brandName}
                </span>
                <span className="hidden md:inline-block px-2 py-0.5 rounded-md bg-teal-50 border border-teal-200 text-[#0F766E] font-mono text-[10px] font-extrabold uppercase">
                  SOLVATHON 2026
                </span>
              </div>
              <p className="text-[11px] font-semibold text-slate-500 hidden sm:block">
                {t.brandSub}
              </p>
            </div>
          </button>

          {/* Primary Navigation Links */}
          <nav className="hidden xl:flex items-center gap-1.5">
            <button
              type="button"
              onClick={() => navigateToSection("ALL")}
              className={`px-3.5 py-2 rounded-xl text-sm font-bold transition cursor-pointer ${
                activeNav === "ALL"
                  ? "bg-slate-100 text-[#0B2545]"
                  : "text-slate-600 hover:text-[#0B2545] hover:bg-slate-50"
              }`}
            >
              {t.navHome}
            </button>
            <button
              type="button"
              onClick={() => navigateToSection("ALL", "register-section")}
              className="px-3.5 py-2 rounded-xl text-sm font-bold text-slate-700 hover:text-[#0D9488] hover:bg-teal-50/60 transition flex items-center gap-1.5 cursor-pointer"
            >
              <Mic className="w-4 h-4 text-[#0D9488]" />
              <span>{t.navReport}</span>
            </button>
            <button
              type="button"
              onClick={() => navigateToSection("ALL", "ivr-section")}
              className="px-3.5 py-2 rounded-xl text-sm font-bold text-slate-700 hover:text-[#0D9488] hover:bg-teal-50/60 transition flex items-center gap-1.5 cursor-pointer"
            >
              <PhoneCall className="w-4 h-4 text-[#0D9488]" />
              <span>{t.navIvr}</span>
            </button>
            <button
              type="button"
              onClick={() => navigateToSection("ALL", "track-section")}
              className="px-3.5 py-2 rounded-xl text-sm font-bold text-slate-700 hover:text-[#0D9488] hover:bg-teal-50/60 transition flex items-center gap-1.5 cursor-pointer"
            >
              <Search className="w-4 h-4 text-[#0D9488]" />
              <span>{t.navTrack}</span>
            </button>
            <button
              type="button"
              onClick={() => navigateToSection("ALL", "admin-section")}
              className="px-3.5 py-2 rounded-xl text-sm font-bold text-slate-700 hover:text-[#0B2545] hover:bg-slate-100 transition flex items-center gap-1.5 cursor-pointer"
            >
              <ShieldCheck className="w-4 h-4 text-[#0B2545]" />
              <span>{t.navAdmin}</span>
            </button>
          </nav>

          {/* Right Controls: Language Pill Toggle, Notification Bell, Citizen Login, Admin Login */}
          <div className="flex items-center gap-2 sm:gap-2.5">
            {/* Bilingual Language Toggle: English | ಕನ್ನಡ */}
            <div className="flex items-center rounded-xl bg-slate-100 p-1 border border-slate-200">
              <button
                type="button"
                onClick={() => setUiLang("en")}
                className={`px-2.5 py-1.5 rounded-lg text-xs font-extrabold transition cursor-pointer ${
