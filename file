          <button
            type="button"
            onClick={() => navigateToSection("ALL", "track-section")}
            className="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-[#0B2545] shrink-0 cursor-pointer"
          >
            🔍 {t.navTrack}
