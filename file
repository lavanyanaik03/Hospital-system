          <button
            type="button"
            onClick={() => navigateToSection("ALL", "admin-section")}
            className="px-3 py-1.5 rounded-lg bg-white border border-slate-200 text-[#0B2545] shrink-0 cursor-pointer"
          >
            🏥 {t.navAdmin}
          </button>
        </div>
      </header>

      {/* IN-APP NOTIFICATION & FOLLOW-UP DRAWER */}
      {showNotifications && (
        <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex justify-end">
          <div className="w-full max-w-md bg-white h-full shadow-2xl border-l border-slate-200 flex flex-col">
            <div className="p-5 bg-[#0B2545] text-white flex items-center justify-between">
              <div>
                <h3 className="font-extrabold text-base flex items-center gap-2">
                  <Bell className="w-4 h-4 text-teal-300" />
                  <span>Notification & Follow-Up Center</span>
                </h3>
                <p className="text-xs text-slate-300 mt-0.5">
                  In-App, SMS-Ready & Automated Voice Alert Queue
                </p>
              </div>
              <button
                type="button"
                onClick={() => setShowNotifications(false)}
                className="p-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>

            <div className="px-5 py-2.5 bg-slate-50 border-b border-slate-200 flex items-center justify-between text-xs">
              <span className="font-bold text-slate-600">
                {notificationsList.length} Alerts ({unreadCount} Unread)
              </span>
              <button
                type="button"
                onClick={handleMarkAllNotificationsRead}
                className="font-bold text-[#0D9488] hover:underline cursor-pointer"
              >
                Mark All as Read
              </button>
            </div>

            <div className="flex-1 overflow-y-auto p-4 space-y-3">
              {notificationsList.map((n) => (
                <div
                  key={n.id}
                  onClick={() => {
                    setShowNotifications(false);
                    handleTrackSpecificComplaint(n.complaintId);
                  }}
                  className={`p-3.5 rounded-xl border transition cursor-pointer ${
                    n.type === "OVERDUE_ALERT"
                      ? "bg-red-50/70 border-red-200"
                      : n.type === "RESOLUTION"
                      ? "bg-emerald-50/70 border-emerald-200"
                      : !n.isRead
                      ? "bg-teal-50/50 border-teal-200"
                      : "bg-white border-slate-200"
                  }`}
                >
                  <div className="flex items-center justify-between gap-2 mb-1">
                    <span className="px-2 py-0.5 rounded bg-slate-900 text-white font-mono text-[10px] font-bold">
                      {n.channel} • {n.recipientType}
                    </span>
                    <span className="text-[10px] font-mono text-slate-500">
                      {new Date(n.createdAt).toLocaleTimeString([], {
                        hour: "2-digit",
                        minute: "2-digit",
                      })}
                    </span>
                  </div>
                  <h4 className="font-extrabold text-xs text-[#0B2545]">
                    {n.title}
                  </h4>
                  <p className="text-xs text-slate-700 mt-1 leading-relaxed">
                    {n.message}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}

      {/* CITIZEN ACCESS / MY GRIEVANCES MODAL */}
      {showCitizenModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="w-full max-w-md bg-white rounded-2xl border border-slate-200 shadow-2xl overflow-hidden">
            <div className="bg-[#0B2545] text-white p-5 flex items-center justify-between">
              <div>
                <h3 className="font-extrabold text-lg">
                  Citizen Simplified Access Portal
                </h3>
                <p className="text-xs text-slate-300">
                  No complex passwords required for rural & senior citizens
                </p>
              </div>
              <button
                type="button"
                onClick={() => setShowCitizenModal(false)}
                className="p-1.5 rounded-lg bg-slate-800 text-white cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
            <div className="p-6 space-y-4">
              <div>
                <label className="block text-xs font-bold uppercase tracking-wider text-slate-700 mb-1">
                  Enter Mobile Number (Demo Citizen Login)
                </label>
                <input
                  type="tel"
                  value={citizenPhoneInput}
                  onChange={(e) => setCitizenPhoneInput(e.target.value)}
                  className="w-full h-12 px-3.5 rounded-xl border border-slate-300 font-mono text-base font-bold"
                  placeholder="e.g. 98450-11223"
                />
              </div>

              <div className="p-3.5 rounded-xl bg-teal-50 border border-teal-200 text-xs text-slate-700 space-y-2">
                <div className="font-bold text-[#0B2545]">
                  Quick Access to Your Linked / Demo Complaints:
                </div>
                <div className="flex flex-wrap gap-1.5">
                  {[
                    ...recentSessionIds,
                    "JSV-2026-1001",
                    "JSV-2026-1002",
                    "JSV-2026-1003",
                  ].map((id) => (
                    <button
                      key={id}
                      type="button"
                      onClick={() => {
                        setCitizenLoggedInPhone(citizenPhoneInput);
                        setShowCitizenModal(false);
                        handleTrackSpecificComplaint(id);
                      }}
                      className="px-2.5 py-1.5 rounded-lg bg-white border border-teal-300 font-mono font-bold text-[#0B2545] hover:bg-teal-100 cursor-pointer"
                    >
                      {id} →
                    </button>
                  ))}
                </div>
              </div>

              <button
                type="button"
                onClick={() => {
                  setCitizenLoggedInPhone(citizenPhoneInput);
                  setShowCitizenModal(false);
                }}
                className="w-full py-3 rounded-xl bg-[#0D9488] hover:bg-[#0F766E] text-white font-extrabold text-sm cursor-pointer"
              >
                Continue as Verified Citizen ({citizenPhoneInput})
              </button>
            </div>
          </div>
        </div>
      )}

      {/* 3. HERO LANDING SECTION */}
      <section className="bg-gradient-to-br from-[#0B2545] via-[#10315C] to-[#134E4A] text-white py-12 sm:py-16 px-4 sm:px-6 lg:px-8 border-b border-slate-800">
        <div className="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          {/* Left 7 Cols: Branding, Tagline, Required Message & Primary Actions */}
          <div className="lg:col-span-7 space-y-6">
            <div className="inline-flex flex-wrap items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/10 border border-white/20 text-teal-300 text-xs sm:text-sm font-bold">
              <Sparkles className="w-4 h-4" />
              <span>
                SOLVATHON 2026 • Accessible Public Healthcare Grievance Platform
              </span>
            </div>

